{
  "name": "ai-audiobook-backend",
  "version": "1.0.0",
  "description": "An app that creates audiobooks from AI",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "start": "env-cmd functions-framework --target=generate",

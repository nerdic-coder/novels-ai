    "start:delete": "functions-framework --target=delete --port 8081",
    "lint": "eslint src/**/*.js"
  },
  "author": "The Nerdic Coder",
  "license": "UNLICENSED",
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.4",
    "@google-cloud/storage": "^7.14.0",
    "@google-cloud/text-to-speech": "^5.7.0",
    "ai-audiobook-backend": "file:",
    "elevenlabs": "^1.50.2",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "handlebars": "^4.7.8",
    "openai": "^4.77.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "env-cmd": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-plugin-import": "^2.31.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
